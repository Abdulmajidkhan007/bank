# Server
PORT=4000
NODE_ENV=development

# Eskiz.uz credentials — https://my.eskiz.uz/
ESKIZ_EMAIL=your-email@example.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_FROM=4546

# In dev mode the OTP is logged to console instead of really sending an SMS.
# Set to "true" once you have an approved Eskiz template.
ESKIZ_LIVE=false

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP behaviour
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# CORS origin (mobile app uses its own scheme, so * is OK during dev)
CORS_ORIGIN=*
