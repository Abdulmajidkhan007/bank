{
  "expo": {
    "name": "UzCard Bank",
    "slug": "uzcard-bank",
    "scheme": "uzcard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.uzcard.bank",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate to access your accounts securely.",
        "NSCameraUsageDescription": "We need access to your camera to verify your identity."
      }
    },
    "android": {
      "package": "uz.uzcard.bank",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "We need access to your camera to verify your identity."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
