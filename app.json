{
  "expo": {
    "name": "UzCard Bank",
    "slug": "uzcard-bank",
    "scheme": "uzcard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.uzcard.bank",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate to access your accounts securely."
      }
    },
    "android": {
      "package": "uz.uzcard.bank"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
